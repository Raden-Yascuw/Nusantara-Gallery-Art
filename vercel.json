{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.3"
    },
    "*.php": {
      "runtime": "vercel-php@0.7.3",
      "includeFiles": "data/**,layout/**,assets/**"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/data/(.*)",
      "dest": "/data/$1"
    },
    {
      "src": "/",
      "dest": "/index.php"
    },
    {
      "src": "/(about|catalog|detail|formulir|layanan|login|register)",
      "dest": "/$1.php"
    },
    {
      "src": "/(.*).php",
      "dest": "/$1.php"
    }
  ]
}
